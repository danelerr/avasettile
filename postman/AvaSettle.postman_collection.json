    {
      "name": "Admin · Clientes",
      "description": "Endpoints de operador de plataforma. Usan {{adminApiKey}}.",
      "item": [
        {
          "name": "Crear cliente → guarda clientApiKey + clientId",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fintech LATAM SA\",\n  \"webhookUrl\": \"https://api.fintech-latam.example/avasettle/webhooks\",\n  \"metadata\": {\n    \"country\": \"CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "La API key en texto plano se devuelve UNA sola vez. El test la guarda en {{clientApiKey}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('clientApiKey', j.apiKey);",
                  "pm.collectionVariables.set('clientId', j.id);",
                  "pm.test('cliente creado', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "console.log('clientId =', j.id, '· apiKey =', j.apiKey);"
                ]
