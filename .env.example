PORT=3001
NODE_ENV=development

# B2B authentication. Chain Flow can send this as:
# x-avasettle-api-key: <value>
# or Authorization: Bearer <value>
AVASETTLE_API_KEY=change-me

# avalanche-fuji or avalanche-mainnet
AVASETTLE_NETWORK=avalanche-fuji
AVASETTLE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Local JSON persistence used by the hackathon backend.
AVASETTLE_STORAGE_FILE=data/avasettle-ledger.json

# Treasury signer used to broadcast ERC-20 payouts.
# Never commit a real key. Use a dedicated hot wallet with limited balances.
AVASETTLE_TREASURY_PRIVATE_KEY=

# Pay-in address derivation. Required for POST /v1/payins.
# Use a dedicated deposit mnemonic. Do not reuse the treasury signer seed.
AVASETTLE_PAYIN_MNEMONIC=
AVASETTLE_PAYIN_DERIVATION_ACCOUNT=0
AVASETTLE_PAYIN_LOOKBACK_BLOCKS=50000

# Comma-separated enabled assets. Current module supports ERC-20 USDC and USDT.
AVASETTLE_ENABLED_ASSETS=USDC

# Configure the exact token contracts for the selected network.
AVASETTLE_USDC_ADDRESS=
AVASETTLE_USDC_DECIMALS=6
AVASETTLE_MAX_PAYOUT_USDC=1000

AVASETTLE_USDT_ADDRESS=
AVASETTLE_USDT_DECIMALS=6
AVASETTLE_MAX_PAYOUT_USDT=1000

# Operational controls
AVASETTLE_MIN_CONFIRMATIONS=2
AVASETTLE_WAIT_FOR_RECEIPT=false
AVASETTLE_CORS_ORIGINS=*

# Mock risk model thresholds. Replace the service behind RiskService with Wavy Node later.
AVASETTLE_RISK_REVIEW_AMOUNT=10000
AVASETTLE_RISK_REJECT_AMOUNT=50000

# Simulated fiat settlement controls.
AVASETTLE_SETTLEMENT_FIAT_CURRENCY=USD
AVASETTLE_SETTLEMENT_FIAT_RATE=1
