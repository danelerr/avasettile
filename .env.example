# ──────────────────────────────────────────────────────────────────────────────
# AvaSettle — environment variables reference
#
# SECRETS (keep only these in .env / CI secrets / your secrets manager):
#   AVASETTLE_ADMIN_API_KEY, AVASETTLE_TREASURY_PRIVATE_KEY,
#   AVASETTLE_PAYIN_MNEMONIC, DATABASE_URL
#
# EVERYTHING ELSE lives in config/avasettle.json (non-secret, versionable).
# Copy config/avasettle.example.json → config/avasettle.json and edit it.
# You can still override any config-file value with an env var here.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Authentication ─────────────────────────────────────────────────────────────
# Platform-operator key. Required to manage clients via /v1/admin/clients.
# Each client (institution) gets its own API key issued by those endpoints;
# clients authenticate with:
#   x-avasettle-api-key: <client key>   OR   Authorization: Bearer <client key>
AVASETTLE_ADMIN_API_KEY=change-me-before-deploying

# ── Treasury signer ───────────────────────────────────────────────────────────
# EVM private key of the institutional hot wallet used for payouts and sweeps.
# Must start with 0x. Use a KMS or HSM in production.
AVASETTLE_TREASURY_PRIVATE_KEY=0xYOUR_TREASURY_PRIVATE_KEY

# ── SettlementVault payout rail (optional) ────────────────────────────────────
# When AVASETTLE_SETTLEMENT_VAULT_ADDRESS is set, payouts route through the
# on-chain SettlementVault (atomic single + batch payouts) instead of a direct
# treasury transfer. The operator key below executes payouts; the treasury
# (funder) only ever grants the vault an ERC-20 allowance — keep it cold.
# The operator key is optional: it falls back to the treasury key when unset.
# AVASETTLE_VAULT_OPERATOR_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY

# ── Confidential settlements (optional) ───────────────────────────────────────
# When AVASETTLE_PRIVATE_SETTLEMENT_REGISTRY_ADDRESS is set, settlements can be
# recorded on-chain as hash commitments (amount/counterparty stay private). The
# registrar key publishes commitments; the auditor key reveals them for audit.
# AVASETTLE_SETTLEMENT_REGISTRAR_PRIVATE_KEY=0xYOUR_REGISTRAR_PRIVATE_KEY
# AVASETTLE_SETTLEMENT_AUDITOR_PRIVATE_KEY=0xYOUR_AUDITOR_PRIVATE_KEY

# ── Pay-in address derivation ─────────────────────────────────────────────────
# BIP-39 mnemonic (12 or 24 words) used to derive deposit addresses via BIP-44.
# Each pay-in gets a unique HD-derived address. Never reuse across environments.
AVASETTLE_PAYIN_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Database (required) ───────────────────────────────────────────────────────
# AvaSettle persists all state in PostgreSQL.
DATABASE_URL=postgres://user:password@localhost:5432/avasettle

# ── Config file path (optional) ───────────────────────────────────────────────
# Defaults to config/avasettle.json if not set.
# AVASETTLE_CONFIG_FILE=config/avasettle.json

# ──────────────────────────────────────────────────────────────────────────────
# The variables below are normally set via config/avasettle.json.
# List them here only if you need to override the config file for a specific env.
# ──────────────────────────────────────────────────────────────────────────────

# AVASETTLE_NETWORK=avalanche-fuji
# AVASETTLE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# AVASETTLE_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# AVASETTLE_PAYMENT_ROUTER_ADDRESS=0xYourDeployedPaymentRouter
# AVASETTLE_SETTLEMENT_VAULT_ADDRESS=0xYourDeployedSettlementVault
# AVASETTLE_PRIVATE_SETTLEMENT_REGISTRY_ADDRESS=0xYourDeployedRegistry
# AVASETTLE_DATABASE_SSL=false
# AVASETTLE_DATABASE_AUTO_MIGRATE=true
# AVASETTLE_AUTO_RECONCILE_INTERVAL_SECONDS=60
# AVASETTLE_AUTO_SWEEP=false
# AVASETTLE_THROTTLE_RPS=100
# AVASETTLE_TRUST_PROXY=1
# AVASETTLE_WEBHOOK_DISPATCH_INTERVAL_SECONDS=5
