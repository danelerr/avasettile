---
const steps = [
  {
    n: '01',
    title: 'Crea el cobro',
    text: 'Tu backend llama a la API. AvaSettle deriva una dirección EVM única para ese invoice (o genera una invoice programable on-chain).',
  },
  {
    n: '02',
    title: 'Tu cliente paga USDC',
    text: 'Desde cualquier wallet o exchange, sobre Avalanche C-Chain. Finalidad en menos de 2 segundos.',
  },
  {
    n: '03',
    title: 'Conciliación automática',
    text: 'AvaSettle detecta la transferencia, valida monto y confirmaciones, y marca el estado del cobro: confirmado, pago parcial o pago en exceso.',
  },
  {
    n: '04',
    title: 'Sweep a tesorería',
    text: 'Los fondos se consolidan a tu treasury institucional con top-up de gas y reintentos automáticos.',
  },
  {
    n: '05',
    title: 'Webhook + reporte',
    text: 'Recibes un webhook firmado con entrega garantizada, y cada operación queda en reportes y auditoría exportable.',
  },
];
---

<section class="section how" id="como-funciona">
  <div class="container">
    <p class="eyebrow reveal">Cómo funciona</p>
    <h2 class="section-title reveal">Del pago on-chain a la operación conciliada</h2>
    <p class="section-lead reveal">
      Cinco capas, como nuestro logo: cada nivel convierte una transferencia
      de USDC en algo que tu equipo financiero puede operar.
    </p>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step reveal" style={`--reveal-delay: ${i * 0.08}s`}>
            <span class="step-n mono">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--white);
    border-block: 1px solid var(--glacier);
  }

  .steps {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding-top: 22px;
  }

  /* Connecting rail across the top */
  .step::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: -22px;
    height: 2px;
    background: var(--glacier);
  }

  .step:last-child::before {
    right: 0;
  }

  .step::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--settle-red);
  }

  .step-n {
    font-size: 12px;
    color: var(--slate-400);
    letter-spacing: 0.06em;
  }

  .step h3 {
    font-size: 17px;
    margin-block: 8px 10px;
  }

  .step p {
    font-size: 14px;
    color: var(--slate-600);
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .step {
      padding: 0 0 32px 34px;
    }

    .step::before {
      top: 5px;
      left: 5px;
      right: auto;
      bottom: 0;
      width: 2px;
      height: auto;
    }

    .step:last-child::before {
      display: none;
    }
  }
</style>
